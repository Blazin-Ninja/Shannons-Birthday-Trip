{
  "name": "shannons-birthday-trip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "generate:icon": "node scripts/generate-app-icon.mjs",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build-release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "env:from-firebase": "node scripts/import-firebase-config.mjs",
    "firebase:guide": "node scripts/firebase-setup-guide.mjs",
    "firebase:login": "firebase login",
    "firebase:deploy-rules": "firebase deploy --only database"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/geolocation": "^7.1.4",
    "firebase": "^11.10.0",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^13.35.1",
    "sharp": "^0.35.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.6"
  }
}
